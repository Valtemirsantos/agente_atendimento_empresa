# Copie este arquivo para .env e preencha com os valores locais do seu ambiente.
# O arquivo .env não deve ser versionado.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=sqlite:///empresa.db

# Chave interna opcional para compatibilidade local.
INTERNAL_API_KEY=

# JSON com chaves por perfil. Exemplo: "support" e "admin".
# IMPORTANTE: use chaves reais em seu ambiente local, nunca as envie para o GitHub.
ACCESS_KEYS={"support":"replace_support_key","admin":"replace_admin_key"}

# Chave longa e aleatória para proteger o identificador de sessão.
CONVERSATION_HASH_KEY=

CONVERSATION_RETENTION_DAYS=30
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
REQUIRE_HTTPS=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Opcional: usada para gerar backups criptografados do banco local.
BACKUP_ENCRYPTION_KEY=